# Copy to .env.local and fill in. All keys are optional except where noted.

# --- AI insights: OpenCode Zen — powers dashboard briefs + per-coin trade analysis ---
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=mimo-v2.5-pro

# --- CoinGecko (optional: raises REST rate limits; app works without) ---
COINGECKO_API_KEY=

# --- CryptoCompare news (optional: app works key-less) ---
CRYPTOCOMPARE_API_KEY=
